# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FERNET_SECRET_KEY=change-me-generate-with-cryptography.fernet.Fernet.generate_key()
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database (overridden by docker-compose service env) ───────────────────────
DATABASE_URL=postgresql+asyncpg://newsroom:newsroom_secret@localhost:5433/newsroom_db
DATABASE_URL_SYNC=postgresql+psycopg2://newsroom:newsroom_secret@localhost:5433/newsroom_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── News Discovery ────────────────────────────────────────────────────────────
NEWSAPI_KEY=your-newsapi-org-key

# ── Media ─────────────────────────────────────────────────────────────────────
# Google Custom Search (image search)
GOOGLE_CSE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id
# Unsplash (image search fallback)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ── Meta Graph API ────────────────────────────────────────────────────────────
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret
META_REDIRECT_URI=http://localhost:8080/api/social-accounts/meta/callback

# ── Verification thresholds (configurable) ────────────────────────────────────
CONFIDENCE_LOW_THRESHOLD=0.35
CONFIDENCE_HIGH_THRESHOLD=0.65

# ── Media storage ─────────────────────────────────────────────────────────────
MEDIA_DIR=/app/media
